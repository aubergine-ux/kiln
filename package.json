{
  "name": "kiln",
  "productName": "Kiln",
  "version": "0.1.0",
  "description": "A friendly instance and mod manager for Java Edition that plays through the official launcher.",
  "main": "out/main/index.js",
  "author": "Aubergine-UX",
  "license": "MIT",
  "homepage": "https://github.com/aubergine-ux/kiln",
  "repository": "github:aubergine-ux/kiln",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && svelte-check --tsconfig tsconfig.web.json --fail-on-warnings",
    "test": "vitest run",
    "test:e2e": "electron-vite build && playwright test",
    "dist": "npm run build && electron-builder",
    "screenshots": "electron-vite build && playwright test --config scripts/screenshots/playwright.config.ts"
  },
  "dependencies": {
    "smol-toml": "^1.9.1",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@playwright/test": "^1.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.9",
    "@types/node": "^26.6.6",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "lucide": "^1.75.0",
    "svelte": "^5.58.0",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "desktopName": "kiln.desktop"
}
